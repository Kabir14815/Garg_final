# MongoDB - copy this file to .env and add your connection string
# Never commit .env or real credentials to git
# Example Atlas SRV (replace USERNAME, PASSWORD, cluster host; add retryWrites / w as in Atlas UI):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
# MONGODB_DB_NAME=garg

# Live metal rates — GoldAPI helps when Goodreturns is off or fails (USD/oz × USD/INR is last resort)
# https://www.goldapi.io/dashboard
# GOLDAPI_API_KEY=

# Seconds to keep a successful live fetch before refreshing again (default 3600 = hourly). Use 86400 for daily-only.
# METAL_RATES_TTL_SEC=3600
# Seconds to wait after a failed fetch before retrying (default 120).
# METAL_RATES_RETRY_AFTER_FAIL_SEC=120

# Gurgaon board rates from Goodreturns (scraped with cloudscraper; falls back to GoldAPI if disabled or on failure)
# GOODRETURNS_ENABLED=1
# GOODRETURNS_GOLD_URL=https://www.goodreturns.in/gold-rates/gurgaon.html
# GOODRETURNS_SILVER_URL=https://www.goodreturns.in/silver-rates/gurgaon.html
